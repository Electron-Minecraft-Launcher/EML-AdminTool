/**
 * ! For enums, add a const in $lib/utils/db.ts with the same name but without the "I" prefix, and the values as keys with the same value.
 * ! This allows using them in both server and client code without importing from @prisma/client directly, which can cause issues in SvelteKit.
 */

generator client {
  provider      = "prisma-client-js"
  output        = "../node_modules/.prisma/client"
  binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE // User is active and can log in
  PENDING // User is pending activation by an admin, can log in
  SPAM // User is flagged as spam (wrong PIN), can log in
  DELETED // User is deleted and cannot log in
}

enum ProfileVisibility {
  PUBLIC
  HIDDEN
  PROTECTED
}

enum LoaderType {
  VANILLA
  FORGE
  NEOFORGE
  FABRIC
  QUILT
}

enum BackgroundStatus {
  ACTIVE
  INACTIVE
}

enum StatAction {
  STARTUP
  LOGIN
  LAUNCH
  BOOTSTRAP
}

model Environment {
  id        String   @id @default(cuid(2))
  language  String   @default("en")
  name      String   @default("EML")
  theme     String   @default("default")
  pin       String   @default("000")
  updatedAt DateTime @updatedAt
}

model Log {
  id        String   @id @default(cuid(2))
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  details   String?
  timestamp DateTime @default(now())
}

model Instance {
  id              String                   @id @default(cuid(2))
  name            String
  slug            String                   @unique
  profiles        Profile[]
  userPermissions UserInstancePermission[]
  bootstrap       Bootstrap?
  maintenance     Maintenance?
  news            News[]
  newsCategories  NewsCategory[]
  newsTags        NewsTag[]
  backgrounds     Background[]
  stats           Stat[]
  crashReports    CrashReport[]
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
}

/**
 * TODO
 * - Ensure that it is possible to create multiples profiles with the same name but different instanceId. OK
 * - Find a way to give users specific permissions on a Instance. OK
 * - Update the code to implement Instances (URL slug, backend, etc.).
 */

model Profile {
  id                                  String                                      @id @default(cuid(2))
  name                                String
  instanceId                          String
  instance                            Instance                                    @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  isDefault                           Boolean                                     @default(false) // Only one profile can be default per instance
  slug                                String
  ip                                  String?
  port                                Int?
  tcpProtocol                         String?
  loader                              Loader?
  hidden                              Boolean?                                    @default(false)
  visibility                          ProfileVisibility?                          @default(PUBLIC)
  allowedPseudos                      String[]                                    @default([])
  password                            String?
  userInstanceFilesUpdaterPermissions UserInstanceProfileFilesUpdaterPermission[]
  createdAt                           DateTime                                    @default(now())
  updatedAt                           DateTime                                    @updatedAt

  @@unique([slug, instanceId])
}

model User {
  id                  String                   @id @default(cuid(2))
  username            String                   @unique
  password            String
  status              UserStatus               @default(PENDING)
  isAdmin             Boolean                  @default(false)
  instancePermissions UserInstancePermission[]
  logs                Log[]
  news                News[]
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
}

model Loader {
  id               String     @id @default(cuid(2))
  profile          Profile    @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId        String     @unique @default("1")
  type             LoaderType
  minecraftVersion String
  loaderVersion    String
  customVersion    String?
  file             Json?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
}

model Bootstrap {
  id         String   @id @default(cuid(2))
  instance   Instance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  instanceId String   @unique
  winFile    Json?
  macFile    Json?
  linFile    Json?
  version    String
  updatedAt  DateTime @updatedAt
}

model Maintenance {
  id             String    @id @default(cuid(2))
  instance       Instance  @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  instanceId     String    @unique
  startTime      DateTime?
  endTime        DateTime?
  message        String    @default("")
  allowedPseudos String[]  @default([])
}

model News {
  id         String         @id @default(cuid(2))
  instance   Instance       @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  instanceId String
  title      String
  content    String
  authorId   String
  author     User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  categories NewsCategory[]
  tags       NewsTag[]
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
}

model NewsCategory {
  id         String   @id @default(cuid(2))
  instance   Instance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  instanceId String
  name       String   @unique
  news       News[]
  createdAt  DateTime @default(now())
}

model NewsTag {
  id         String   @id @default(cuid(2))
  instance   Instance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  instanceId String
  name       String   @unique
  color      String
  news       News[]
}

model Background {
  id         String           @id @default(cuid(2))
  instance   Instance         @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  instanceId String
  name       String           @unique
  file       Json
  status     BackgroundStatus @default(ACTIVE)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
}

model Stat {
  id         String     @id @default(cuid(2))
  instance   Instance   @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  instanceId String
  action     StatAction
  value      String?
  createdAt  DateTime   @default(now())
}

model CrashReport {
  id            String    @id @default(cuid(2))
  instance      Instance  @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  instanceId    String
  date          String
  os            String
  arch          String
  javaVersion   String
  javaArch      String
  profile       String?
  version       String
  loader        String
  loaderVersion String?
  authType      String
  minRam        Float?
  maxRam        Float?
  exitCode      Int
  addressedAt   DateTime?
  comment       String?
  createdAt     DateTime  @default(now())
  fileId        String    @unique
}

model ExpiredToken {
  id        String   @id @default(cuid(2))
  token     String   @unique
  expiredAt DateTime @default(now())
}

model SystemMigration {
  id        String   @id
  appliedAt DateTime @default(now())
}

model UserInstancePermission {
  id                      String                                      @id @default(cuid(2))
  user                    User                                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId                  String
  instance                Instance                                    @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  instanceId              String
  isAdmin                 Boolean                                     @default(false) // Admin can manage users and permissions for THIS instance
  bootstrap               Int                                         @default(0) // 0 = no access, 1 = read and write, 2 = read, write and change loader
  maintenance             Int                                         @default(0) // 0 = no access, 1 = read and write, 2 = admin (can change allowed pseudos)
  news                    Int                                         @default(0) // 0 = no access, 1 = read and write, 2 = admin (can delete news they did not create)
  newsCategories          Int                                         @default(0) // 0 = no access, 1 = read and write
  newsTags                Int                                         @default(0) // 0 = no access, 1 = read and write
  backgrounds             Int                                         @default(0) // 0 = no access, 1 = read and write
  stats                   Int                                         @default(0) // 0 = no access, 1 = read, 2 = read and reset
  crashReports            Int                                         @default(0) // 0 = no access, 1 = read, 2 = read and delete
  filesUpdaterPermissions UserInstanceProfileFilesUpdaterPermission[]
  createdAt               DateTime                                    @default(now())
  updatedAt               DateTime                                    @updatedAt
}

model UserInstanceProfileFilesUpdaterPermission {
  id                       String                 @id @default(cuid(2))
  userInstance             UserInstancePermission @relation(fields: [UserInstancePermissionId], references: [id], onDelete: Cascade)
  UserInstancePermissionId String
  profile                  Profile                @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId                String
  permission               Int                    @default(0) // 0 = no access, 1 = read and write, 2 = read, write and change loader
  createdAt                DateTime               @default(now())
  updatedAt                DateTime               @updatedAt

  @@unique([UserInstancePermissionId, profileId])
}
